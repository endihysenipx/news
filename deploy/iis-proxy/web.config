<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" maxRequestLength="10240" />
  </system.web>
  <system.webServer>
    <handlers>
      <add name="NewsProxy" path="*" verb="*" type="NewsProxyHandler" resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>
